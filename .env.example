# From https://developers.kite.trade. Set your Kite app's redirect URL to http://localhost:8000/auth/callback
KITE_API_KEY=
KITE_API_SECRET=

# Kite requires market protection on MARKET orders. -1 lets Kite choose; or 1-100 (percent).
MARKET_PROTECTION=-1
# Exchange freeze limits in units; bigger orders are sent as several slices.
FREEZE_QTY_NIFTY=1800
FREEZE_QTY_SENSEX=1000
