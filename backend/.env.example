# From https://developers.kite.trade (set the app's redirect URL to http://localhost:8000/auth/callback)
KITE_API_KEY=
KITE_API_SECRET=
# true = sample positions, no Kite account needed
DEMO_MODE=false
FRONTEND_URL=http://localhost:3000

# Risk limits
MAX_PORTFOLIO_LOSS=50000
MAX_LOSS_PER_UNDERLYING=25000
MAX_ABS_DELTA_PER_UNDERLYING=150
PREMIUM_MULTIPLE_ALERT=2.0
BREACH_BUFFER_PCT=0.5
